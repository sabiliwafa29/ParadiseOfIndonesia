APP_NAME="PNB Travel"
APP_ENV=production
APP_KEY=base64:GENERATED_BY_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://pnbtravel.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=${DATABASE_URL}
DB_SSLMODE=require
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=paradise
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
# For production with S3-backed storage, set FILESYSTEM_DISK to "s3"
# FILESYSTEM_DISK=s3
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_CONNECTION=default
SESSION_COOKIE=pnbtravel_session
SESSION_DOMAIN=.pnbtravel.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional: if you serve storage assets through a CDN (CloudFront, Cloudflare, etc.)
# set CDN_URL to the CDN base URL (no trailing slash). When present, Storage::url()
# will prefer CDN_URL for the public disk and S3-backed assets.
CDN_URL=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"

# ============================================================================
# PAYMENT GATEWAY - MIDTRANS
# ============================================================================

MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxx
MIDTRANS_MERCHANT_ID=merchant-id
MIDTRANS_IS_PRODUCTION=false

# PayPal
PAYPAL_CLIENT_ID=AbKXY_hewz8f5WuMTMUK85QARqVFQmyAZiJ4yqNiS7r2KqBsyuWFCAD2W9qLnnsg84ZcAoamHB25eG6W
PAYPAL_SECRET=ENT9zm0x7sHUNjNQ_tUea852Pfco1pAn--tcKoaREW26Wuw-CVCcWYb0BdrrwAAWbp1YSGMSIBBC8VQt
PAYPAL_IS_PRODUCTION=true

# ============================================================================
# THIRD-PARTY SERVICES
# ============================================================================

GOOGLE_CLIENT_ID=.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://pnbtravel.com/auth/google/callback

OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT=10
OSRM_PROFILE=driving

# ============================================================================
# SENTRY (Error monitoring)
# ============================================================================
# Set to your Sentry DSN for Laravel (leave empty to disable in local)
SENTRY_LARAVEL_DSN=
# Performance tracing sample rate (0.0 = disabled, 1.0 = 100%)
SENTRY_TRACES_SAMPLE_RATE=0.0
# Environment and release information (optional)
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_SEND_DEFAULT_PII=false

# ============================================================================
# VERCEL DEPLOYMENT
# ============================================================================

VERCEL_ENV=production
APP_CONFIG_CACHE=/tmp/bootstrap/cache/config.php
APP_EVENTS_CACHE=/tmp/bootstrap/cache/events.php
APP_PACKAGES_CACHE=/tmp/bootstrap/cache/packages.php
APP_ROUTES_CACHE=/tmp/bootstrap/cache/routes.php
APP_SERVICES_CACHE=/tmp/bootstrap/cache/services.php
VIEW_COMPILED_PATH=/tmp/bootstrap/cache/views
